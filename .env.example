# Port the HTTP server listens on
PORT=3000

# One log line when a request arrives and one when it finishes (true/false)
LOG_REQUESTS=true

# text = human readable, json = one JSON object per line for log collectors
LOG_FORMAT=text

# Max request body size
BODY_LIMIT=2mb

# Comma-separated API keys. Leave empty for an open API. /health is always open.
# API_KEYS=change-me-1,change-me-2

# OAuth 2.0: accept signed access tokens (JWTs) from your identity provider.
# Needs OAUTH_ISSUER and OAUTH_AUDIENCE. Can be combined with API_KEYS (either credential works).
# For local testing, run `npm run mock-oauth` and use http://localhost:4000 (see docs/OAUTH.md).
# OAUTH_ISSUER=https://idp.example.com/
# OAUTH_AUDIENCE=de-idfr-svc
# Defaults to <issuer>/.well-known/jwks.json
# OAUTH_JWKS_URI=https://idp.example.com/.well-known/jwks.json
# Scopes every token must carry, space or comma separated
# OAUTH_REQUIRED_SCOPES=deidfr:write

# Max requests per client IP per window. 0 = off.
RATE_LIMIT_MAX=0
RATE_LIMIT_WINDOW_MS=60000

# Set true when running behind a reverse proxy / load balancer
TRUST_PROXY=false

# Optional: path to a JSON file with custom rules (see rules.example.json)
# CUSTOM_RULES_FILE=rules.json
